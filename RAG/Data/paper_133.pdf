window.loswp.translateUrl = "https://www.academia.edu/login?post_login_redirect_url=https%3A%2F%2Fwww.academia.edu%2F29327060%2FEnvironmental_magnetism_of_Antarctic_Late_Pleistocene_sediments_and_interhemispheric_correlation_of_climatic_events%3Fshow_translation%3Dtrue";
window.loswp.previewableAttachments = [{"id":49766725,"identifier":"Attachment_49766725","shouldShowBulkDownload":false}];
window.loswp.shouldDetectTimezone = true;
window.loswp.shouldShowBulkDownload = true;
window.loswp.showSignupCaptcha = false
window.loswp.willEdgeCache = false;
window.loswp.work = {"work":{"id":29327060,"created_at":"2016-10-21T08:52:25.366-07:00","from_world_paper_id":158466700,"updated_at":"2024-11-15T20:19:17.471-08:00","_data":{"grobid_abstract":"Recent developments in paleomagnetism and environmental magnetism provide new tools for the detailed correlation of climatically induced magnetic mineralogy changes in sedimentary sequences. Studies of these changes contribute to the reconstruction of climate history for the glacial^interglacial cycles of the Late Pleistocene and to the delineation of the range of natural variability for global climate during the past hundred thousands years. Here we show that sharp coercivity minima observed in fine-grained sediments from the continental rise of the western Antarctic Peninsula correlate to the major rapid cooling events of the northern Atlantic (Heinrich layers). We interpret such an environmental magnetic signal in terms of variations in deep sea diagenetic processes of sulfide formation, which reflect changes in the input of detrital organic matter controlled by sea-ice extent. With the inherent uncertainties in age controls, the sedimentary paleoclimatic markers of the two hemispheres are almost contemporaneous, but interhemispheric time lags or leads of the order of 1^2 kyr (such as those recently reported from the Greenland and Antarctic ice cores) are also compatible with the data. ß","publication_date":"2001,,","publication_name":"Earth and Planetary Science Letters","grobid_abstract_attachment_id":"49766725"},"document_type":"paper","pre_hit_view_count_baseline":null,"quality":"high","language":"en","title":"Environmental magnetism of Antarctic Late Pleistocene sediments and interhemispheric correlation of climatic events","broadcastable":true,"draft":null,"has_indexable_attachment":true,"indexable":true,"seo_quality":null}}["work"];
